# Copy to .env.local for local development (never commit .env.local).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Optional: Microsoft Entra ID login for staff (Administrador, Finanzas, Supervisor, Operador,
# Auditor). Leave both empty to hide the "Iniciar sesión con Microsoft" button entirely — the
# local email/password flow always works regardless. See docs/06-runbook.md for how to connect a
# real tenant.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
