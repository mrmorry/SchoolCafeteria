# Copy to ".env" for local docker-compose use. Never commit the real ".env" file.
# These are LOCAL DEVELOPMENT defaults only — production secrets live in Azure Key Vault,
# never in a file in this repository (see docs/06-runbook.md).

# SQL Server "sa" password used only inside the local docker-compose network.
SQL_SA_PASSWORD=ChangeMe_DevOnly!2026

# HMAC signing key for JWT access tokens (32+ chars). Generate a new random value per environment.
JWT_SIGNING_KEY=change-me-dev-only-please-use-a-random-32-char-value

# Shared secret used to sign/verify the sandbox payment gateway's simulated webhooks.
PAYMENTS_SANDBOX_WEBHOOK_SECRET=change-me-dev-only-sandbox-secret
